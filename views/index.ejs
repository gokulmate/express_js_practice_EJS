<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle %></title>

  <style>
    body {
      font-family: Arial;
      background: #0a0a23;
      color: white;
      margin: 0;
    }

    .navbar {
      display: flex;
      justify-content: space-between;
      padding: 20px;
      background: #12123e;
    }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 15px;
    }

    .nav-links a {
      color: white;
      text-decoration: none;
    }

    .card {
      background: #12123e;
      padding: 15px;
      margin: 10px;
      border-radius: 10px;
    }

    .content {
      padding: 20px;
    }
  </style>
</head>

<body>

<!-- NAVBAR -->
<div class="navbar">
  <h2><%= name %></h2>

  <ul class="nav-links">
    <% navLinks.forEach(link => { %>
      <li>
        <a href="<%= link.href %>"><%= link.label %></a>
      </li>
    <% }) %>
  </ul>
</div>

<!-- MAIN CONTENT -->
<div class="content">

  <h1><%= greeting %> 👋</h1>
  <h2><%= fullName %></h2>
  <p><%= tagline %></p>

  <button><%= primaryBtn %></button>
  <button><%= secondaryBtn %></button>

  <div class="card">
    <img src="<%= imageUrl %>" width="100">
  </div>

</div>

</body>
</html>